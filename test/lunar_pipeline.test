<?xml version="1.0"?>
<launch>
    <!-- CI runs the short sweep; a review run uses n_trials:=10, which is what the task
         book asks for ("每种场景重复≥10次"). The limit has to cover n_trials x the
         scenario's goal tour, each goal with its own drive-to-goal timeout. -->
    <arg name="n_trials" default="3"/>
    <!-- Terrain class: mixed (regression baseline) | flat | dense | slope | negative.
         One rostest invocation exercises one scenario; scripts/run_planner_experiments.py
         loops over all of them. -->
    <arg name="scenario" default="mixed"/>
    <arg name="metrics_out" default=""/>
    <arg name="planning_snapshot_directory" default=""/>
    <arg name="snap_strategy" default="legacy_nearest"/>
    <!-- Trace the full multi-goal run without enabling a short diagnostic (which skips
         metrics_over_trials). Use only for investigating a reproducible regression. -->
    <arg name="debug_control" default="false"/>
    <!-- Short one-turn controller diagnosis. Skips the multi-trial sweep and enables
         throttled follower command traces; normal package/formal tests leave it false. -->
    <arg name="diagnostic_turn" default="false"/>
    <!-- Isolate the default two-metre straight closed-loop check and skip the sweep. This
         diagnoses intermittent terminal non-convergence without paying for n_trials=3. -->
    <arg name="diagnostic_straight" default="false"/>
    <!-- Short mixed-terrain safety diagnosis: drive only to the first hard goal beside the
         (0,-2) boulder, assert ground-truth clearance, and skip the long sweep. -->
    <arg name="diagnostic_hard_goal" default="false"/>
    <node pkg="groundgrid" type="lunar_surface_sim.py" name="lunar_surface_sim">
        <param name="scenario" value="$(arg scenario)"/>
    </node>
    <!-- roslaunch may expose boolean args to $(eval) as bools rather than the literal
         strings "true"/"false". Normalise both forms so diagnostic runs reliably enable
         the follower trace instead of silently inheriting the production default. -->
    <param name="/lunar_path_follower/debug_control"
           value="$(eval str(arg('debug_control')).lower() == 'true' or str(arg('diagnostic_turn')).lower() == 'true' or str(arg('diagnostic_straight')).lower() == 'true' or str(arg('diagnostic_hard_goal')).lower() == 'true')"/>
    <!-- Diagnostic-only: show the failed swept sample for each root arc action and
         recovery manoeuvre. No clearance, acceptance or search parameter is changed. -->
    <param name="/state_lattice_planner/debug_start_rejections" value="$(arg debug_control)"/>
    <include file="$(find groundgrid)/launch/LunarSystem.launch">
        <arg name="planning_snapshot_directory" value="$(arg planning_snapshot_directory)"/>
        <arg name="snap_strategy" value="$(arg snap_strategy)"/>
    </include>
    <test pkg="groundgrid" type="test_lunar_pipeline.py" test-name="lunar_pipeline_test"
          time-limit="3600">
        <param name="n_trials" value="$(arg n_trials)"/>
        <param name="scenario" value="$(arg scenario)"/>
        <param name="metrics_out" value="$(arg metrics_out)"/>
        <param name="diagnostic_turn" value="$(arg diagnostic_turn)"/>
        <param name="diagnostic_straight" value="$(arg diagnostic_straight)"/>
        <param name="diagnostic_hard_goal" value="$(arg diagnostic_hard_goal)"/>
    </test>
</launch>
